# Copy to .env for local overrides; .env is git-ignored (R-34).
#
# Email-sending credentials never belong here or anywhere in this repo (R-27):
# the founder sends every message from their own mail client.

# Database file (default: data/cottonwood.db).
# COTTONWOOD_DB=data/cottonwood.db

# Pilot config file (default: config/pilot.yaml).
# COTTONWOOD_CONFIG=config/pilot.yaml
