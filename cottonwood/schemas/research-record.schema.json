{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cottonwoodcontractors.com/schemas/research-record.schema.json",
  "title": "Cottonwood research record",
  "description": "One researched prospect, as written by the research-prospects skill or by hand and imported with `cottonwood prospects-import` (R-5, R-25). A file holds a JSON array of these records. URLs, dates, email, phone and money amounts are strings here; cottonwood/validate.py checks their form (http(s) URL with a host, real YYYY-MM-DD dates not after today in America/Denver, normalizable email and phone, plain non-negative decimal amounts).",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "organization", "verified_facts", "hypothesis", "evidence"],
  "properties": {
    "record_id": {
      "description": "Optional id of the record within its file, shown in rejection messages.",
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": ["direct_candidate", "relationship_prospect"]
    },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "pattern": "\\S"},
        "domain": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1}
      }
    },
    "contact": {
      "description": "A verified professional contact; name or email is required.",
      "type": "object",
      "additionalProperties": false,
      "anyOf": [{"required": ["name"]}, {"required": ["email"]}],
      "properties": {
        "name": {"type": "string", "pattern": "\\S"},
        "email": {"type": "string", "minLength": 1},
        "phone": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "minLength": 1}
      }
    },
    "property_location": {"type": "string", "minLength": 1},
    "verified_facts": {
      "description": "Facts the evidence supports, kept apart from the hypothesis.",
      "type": "array",
      "items": {"type": "string", "pattern": "\\S"}
    },
    "hypothesis": {
      "description": "What the researcher infers but has not verified; may be empty.",
      "type": "string"
    },
    "next_action": {"type": "string", "minLength": 1},
    "founder_time_h": {"type": "number", "minimum": 0},
    "value": {
      "description": "A money value with its basis (R-9).",
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "basis"],
      "properties": {
        "amount": {"type": "string"},
        "basis": {"enum": ["buyer-stated", "founder-estimated", "unverified"]}
      }
    },
    "referred_by": {
      "description": "Id of the relationship-prospect lead that referred this one (R-12).",
      "type": "integer",
      "minimum": 1
    },
    "is_test": {"type": "boolean"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "observed_at"],
        "anyOf": [{"required": ["excerpt"]}, {"required": ["observation"]}],
        "properties": {
          "url": {"type": "string"},
          "observed_at": {"description": "YYYY-MM-DD the page was read.", "type": "string"},
          "published_at": {"description": "YYYY-MM-DD the source was published.", "type": "string"},
          "excerpt": {"description": "Exact text quoted from the source.", "type": "string", "pattern": "\\S"},
          "observation": {"description": "What was observed, when there is no quotable text.", "type": "string", "pattern": "\\S"},
          "kind": {"enum": ["fact", "hypothesis"]}
        }
      }
    }
  }
}
